{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StratumArchBIMSchema",
  "description": "建築3レイヤー (Skeleton / MEP / Infill) 詳細設計・精密制御モード対応BIMスキーマ",
  "type": "object",
  "required": ["site", "skeleton", "mep", "rooms"],
  "properties": {
    "site": {
      "type": "object",
      "required": ["width", "depth", "floors", "floorHeight"],
      "properties": {
        "width": { "type": "number", "minimum": 6, "maximum": 30 },
        "depth": { "type": "number", "minimum": 6, "maximum": 30 },
        "floors": { "type": "integer", "minimum": 1, "maximum": 5 },
        "floorHeight": { "type": "number", "minimum": 2.8, "maximum": 4.5 },
        "slabThickness": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.45,
          "description": "床スラブ厚 (m)"
        },
        "plenumHeight": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 1.2,
          "description": "二重床・天井裏の設備配管クリアランス高 (m)"
        },
        "defaultCeilingHeight": {
          "type": "number",
          "minimum": 2.1,
          "maximum": 3.6,
          "description": "標準天井高 (m)"
        },
        "structuralModule": {
          "type": "object",
          "properties": {
            "spanX": { "type": "number", "description": "東西方向の基本構造スパン (例: 3.6m / 5.4m)" },
            "spanZ": { "type": "number", "description": "南北方向の基本構造スパン (例: 3.6m / 4.5m)" }
          }
        }
      }
    },
    "skeleton": {
      "type": "object",
      "required": ["columns", "cores"],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "x", "z"],
            "properties": {
              "id": { "type": "string" },
              "gridCode": { "type": "string", "description": "通り芯符号 (例: X1-Y1)" },
              "x": { "type": "number" },
              "z": { "type": "number" },
              "width": { "type": "number", "minimum": 0.12, "maximum": 1.0, "description": "柱断面幅 (m, 例: 0.60)" },
              "depth": { "type": "number", "minimum": 0.12, "maximum": 1.0, "description": "柱断面奥行 (m, 例: 0.60)" }
            }
          }
        },
        "beams": {
          "type": "array",
          "description": "大梁 (girder) および小梁 (secondary) のグリッド座標リスト",
          "items": {
            "type": "object",
            "required": ["id", "kind", "x1", "z1", "x2", "z2", "width", "depth"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "type": "string", "enum": ["girder", "secondary"] },
              "x1": { "type": "number" },
              "z1": { "type": "number" },
              "x2": { "type": "number" },
              "z2": { "type": "number" },
              "width": { "type": "number", "description": "梁幅 (m, 例: 0.35)" },
              "depth": { "type": "number", "description": "梁せい (m, 例: 0.55)" }
            }
          }
        },
        "shearWalls": {
          "type": "array",
          "description": "耐力壁の座標リスト",
          "items": {
            "type": "object",
            "required": ["id", "x1", "z1", "x2", "z2", "thickness"],
            "properties": {
              "id": { "type": "string" },
              "x1": { "type": "number" },
              "z1": { "type": "number" },
              "x2": { "type": "number" },
              "z2": { "type": "number" },
              "thickness": { "type": "number", "description": "耐力壁厚 (m, 例: 0.22)" }
            }
          }
        },
        "cores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "x", "z", "w", "d"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "x": { "type": "number" },
              "z": { "type": "number" },
              "w": { "type": "number" },
              "d": { "type": "number" }
            }
          }
        }
      }
    },
    "mep": {
      "type": "object",
      "required": ["shafts"],
      "properties": {
        "shafts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "label", "x", "z", "radius"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["plumbing", "hvac"] },
              "label": { "type": "string" },
              "x": { "type": "number" },
              "z": { "type": "number" },
              "radius": { "type": "number" }
            }
          }
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "floor", "name", "type", "x", "z", "w", "d", "needsPlumbing"],
        "properties": {
          "id": { "type": "string" },
          "floor": { "type": "integer", "minimum": 1, "maximum": 5 },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["public", "service", "wet", "office", "meeting", "parking"] },
          "x": { "type": "number" },
          "z": { "type": "number" },
          "w": { "type": "number", "minimum": 1.2 },
          "d": { "type": "number", "minimum": 1.2 },
          "needsPlumbing": { "type": "boolean" },
          "ceilingHeight": {
            "type": "number",
            "minimum": 2.0,
            "maximum": 4.0,
            "description": "部屋の天井高 (m)"
          },
          "finishes": {
            "type": "object",
            "description": "床・壁・天井の仕上材コード",
            "properties": {
              "floor": { "type": "string" },
              "wall": { "type": "string" },
              "ceiling": { "type": "string" }
            }
          },
          "fixtures": {
            "type": "array",
            "description": "部屋内の設備・什器のローカル座標リスト (部屋中心からの相対座標 localX, localZ)",
            "items": {
              "type": "object",
              "required": ["id", "type", "label", "localX", "localZ", "w", "d"],
              "properties": {
                "id": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": [
                    "sink",
                    "toilet",
                    "unit_bath",
                    "island_kitchen",
                    "counter_desk",
                    "meeting_table",
                    "bed",
                    "tatami_mat",
                    "lab_bench"
                  ]
                },
                "label": { "type": "string" },
                "localX": { "type": "number" },
                "localZ": { "type": "number" },
                "w": { "type": "number" },
                "d": { "type": "number" }
              }
            }
          },
          "openings": {
            "type": "array",
            "description": "部屋の壁面における窓 (window) およびドア (door) の座標と寸法リスト",
            "items": {
              "type": "object",
              "required": ["id", "type", "wall", "x", "z", "width", "height"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string", "enum": ["window", "door"] },
                "wall": { "type": "string", "enum": ["north", "south", "east", "west"] },
                "x": { "type": "number", "description": "全体座標系における開口部中心X (m)" },
                "z": { "type": "number", "description": "全体座標系における開口部中心Z (m)" },
                "width": { "type": "number", "minimum": 0.5, "maximum": 6.0 },
                "height": { "type": "number", "minimum": 0.5, "maximum": 3.0 },
                "sillHeight": { "type": "number", "minimum": 0.0, "maximum": 2.2 }
              }
            }
          }
        }
      }
    }
  }
}
